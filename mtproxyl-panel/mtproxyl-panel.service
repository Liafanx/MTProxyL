[Unit]
Description=MTProxyL-Panel
After=network.target

[Service]
Type=simple
User=mtproxyl-panel
ExecStart=/usr/local/bin/mtproxyl-panel --config /etc/mtproxyl-panel/config.toml
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

# Let's Encrypt (tls.acme_domain) отвечает на HTTP-01-challenge на порту 80,
# который непривилегированному User=mtproxyl-panel не забиндить. Даём только
# эту способность — не root целиком, — и переживает замену бинарника при
# самообновлении: capability выдаёт systemd при запуске процесса, а не
# setcap на файле, который потерялся бы при следующей sudo mv.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening compatible with sudo-based updater operations
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/etc/mtproxyl-panel /var/lib/mtproxyl-panel

[Install]
WantedBy=multi-user.target
