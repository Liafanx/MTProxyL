+// Partial ME degradation: admission readiness is tracked per DC, and a session
+// may use Middle-End only when its own target DC has a live writer.
+async fn map_admission_dcs(pool: &Arc<MePool>) {
+    let mut map = pool.proxy_map_v4.write().await;
+    map.insert(2, vec![(IpAddr::V4(Ipv4Addr::new(203, 0, 113, 10)), 443)]);
+    map.insert(3, vec![(IpAddr::V4(Ipv4Addr::new(203, 0, 113, 11)), 443)]);
+}
+
+#[tokio::test]
+async fn admission_ready_partial_cast_accepts_partial_dc_coverage() {
+    let pool = make_pool_ipv4_me().await;
+    map_admission_dcs(&pool).await;
+    let addr = SocketAddr::new(IpAddr::V4(Ipv4Addr::new(203, 0, 113, 21)), 4001);
+    insert_writer(&pool, 1, 2, addr, false, Instant::now()).await;
+
+    assert!(pool.admission_ready_partial_cast().await);
+    assert!(!pool.admission_ready_conditional_cast().await);
+    let snapshot = pool.admission_coverage_snapshot().await;
+    assert!(snapshot.configured_dcs.contains(&2) && snapshot.configured_dcs.contains(&3));
+    assert!(snapshot.ready_dcs.contains(&2) && !snapshot.ready_dcs.contains(&3));
+}
+
+#[tokio::test]
+async fn admission_ready_for_target_dc_checks_requested_dc() {
+    let pool = make_pool_ipv4_me().await;
+    map_admission_dcs(&pool).await;
+    let addr = SocketAddr::new(IpAddr::V4(Ipv4Addr::new(203, 0, 113, 21)), 4001);
+    insert_writer(&pool, 1, 2, addr, false, Instant::now()).await;
+
+    assert!(pool.admission_ready_for_target_dc(2).await);
+    assert!(!pool.admission_ready_for_target_dc(3).await);
+}
+
+#[tokio::test]
+async fn admission_ready_for_target_dc_ignores_draining_writer() {
+    let pool = make_pool_ipv4_me().await;
+    map_admission_dcs(&pool).await;
+    let addr = SocketAddr::new(IpAddr::V4(Ipv4Addr::new(203, 0, 113, 21)), 4001);
+    insert_writer(&pool, 1, 2, addr, true, Instant::now()).await;
+
+    assert!(!pool.admission_ready_for_target_dc(2).await);
