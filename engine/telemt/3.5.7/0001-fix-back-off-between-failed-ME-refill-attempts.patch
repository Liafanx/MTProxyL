+#[cfg(test)]
+mod refill_backoff_tests {
+    use super::*;
+
+    #[test]
+    fn delay_grows_and_is_capped() {
+        // Первая неудача — около базы, дальше удвоение до потолка.
+        let d1 = refill_retry_delay(1).as_millis() as u64;
+        let d2 = refill_retry_delay(2).as_millis() as u64;
+        let d9 = refill_retry_delay(9).as_millis() as u64;
+        assert!(
+            (ME_REFILL_RETRY_DELAY_BASE_MS..=ME_REFILL_RETRY_DELAY_BASE_MS * 3 / 2).contains(&d1),
+            "первая задержка вне ожидаемого окна: {d1}"
+        );
+        assert!(d2 >= ME_REFILL_RETRY_DELAY_BASE_MS * 2, "рост не идёт: {d2}");
+        let cap_with_jitter =
+            ME_REFILL_RETRY_DELAY_CAP_MS + ME_REFILL_RETRY_DELAY_CAP_MS / ME_REFILL_RETRY_JITTER_FRAC;
+        assert!(d9 <= cap_with_jitter, "потолок не держится: {d9}");
+    }
+
+    #[test]
+    fn delay_never_overflows_on_large_attempt_counts() {
+        // saturating/checked-арифметика: большой счётчик не должен паниковать.
+        for n in [16u32, 32, 1_000, u32::MAX] {
+            let d = refill_retry_delay(n).as_millis() as u64;
+            let cap_with_jitter = ME_REFILL_RETRY_DELAY_CAP_MS
+                + ME_REFILL_RETRY_DELAY_CAP_MS / ME_REFILL_RETRY_JITTER_FRAC;
+            assert!(d <= cap_with_jitter, "переполнение при n={n}: {d}");
+        }
+    }
+
+    #[test]
+    fn jitter_actually_varies() {
+        // Без разброса восполнения разных эндпоинтов сойдутся в такт — ради
+        // этого джиттер и добавлен, так что проверяем, что он не константа.
+        let seen: std::collections::HashSet<u64> = (0..64)
+            .map(|_| refill_retry_delay(4).as_millis() as u64)
+            .collect();
+        assert!(seen.len() > 1, "джиттер не работает: все значения одинаковы");
+    }
+
+    #[test]
+    fn sixteen_attempts_fit_in_reasonable_window() {
+        // Проектное ограничение: 16 попыток должны укладываться примерно в
+        // 12-20 секунд — быстрее health-пути, но не долбёжка.
+        let total: u64 = (1..=16).map(|n| refill_retry_delay(n).as_millis() as u64).sum();
+        assert!(
+            (8_000..=25_000).contains(&total),
+            "суммарное ожидание вне проектных рамок: {total} мс"
+        );
+    }
+}
