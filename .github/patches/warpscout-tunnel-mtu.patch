@@ -0,0 +1,21 @@
+package main
+
+import (
+	"flag"
+	"fmt"
+	"strconv"
+)
+
+// Runtime MTU for the SOCKS tunnel; scan -mtu remains an export option.
+func addTunnelMTUFlag(fs *flag.FlagSet) {
+	tunnelMTU = 1280
+	fs.Func("tunnel-mtu", "SOCKS tunnel MTU (1000..1500, default 1280)", func(value string) error {
+		n, err := strconv.Atoi(value)
+		if err != nil || n < 1000 || n > 1500 {
+			return fmt.Errorf("tunnel MTU must be between 1000 and 1500")
+		}
+		tunnelMTU = n
+		return nil
+	})
+	fs.Lookup("tunnel-mtu").DefValue = "1280"
+}
--- /dev/null
+++ b/tunnel_mtu_test.go
@@ -0,0 +1,40 @@
+package main
+
+import (
+	"flag"
+	"io"
+	"net/netip"
+	"strconv"
+	"testing"
+)
+
+func TestRuntimeTunnelMTU(t *testing.T) {
+	saved := tunnelMTU
+	t.Cleanup(func() { tunnelMTU = saved })
+	for _, value := range []int{1000, 1280, 1400, 1500} {
+		fs := flag.NewFlagSet("socks", flag.ContinueOnError)
+		var o options
+		setupSocksFlags(fs, &o)
+		if err := fs.Parse([]string{"-tunnel-mtu", strconv.Itoa(value)}); err != nil {
+			t.Fatal(err)
+		}
+		dev, _, err := newIPStack([]netip.Addr{netip.MustParseAddr("172.16.0.2")}, tunnelMTU)
+		if err != nil {
+			t.Fatal(err)
+		}
+		actual, err := dev.MTU()
+		dev.Close()
+		if err != nil || actual != value {
+			t.Fatalf("MTU: %d, %v; want %d", actual, err, value)
+		}
+	}
+	for _, value := range []string{"", "0", "999", "1501", "bad"} {
+		fs := flag.NewFlagSet("socks", flag.ContinueOnError)
+		fs.SetOutput(io.Discard)
+		var o options
+		setupSocksFlags(fs, &o)
+		if err := fs.Parse([]string{"-tunnel-mtu", value}); err == nil {
+			t.Fatalf("accepted %q", value)
+		}
+	}
+}
